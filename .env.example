# ============================================================
# 新能源汽车充电桩运营服务平台 (ev-charge-hub) 环境变量模板
# 使用方法：复制本文件为 .env，并填写你本机的真实配置（.env 禁止提交到 Git）
# ============================================================

# 应用名称（展示在 FastAPI Swagger /docs 页面标题）
APP_TITLE=新能源汽车充电桩运营服务平台

# 运行环境标识（本地开发/答辩/测试可选 development / dev / local / test，默认 development）
# 非本地环境（如 production / staging）将强制校验非占位且长度 >= 16 的强 SECRET_KEY，并默认关闭开发快捷 Token
APP_ENV=development

# MySQL 连接串（必填）
# 格式：mysql+pymysql://<用户名>:<密码>@<主机>:<端口>/<数据库名>?charset=utf8mb4
# 注意：若密码含 @ # % 等特殊字符，请先做 URL 编码或改用无特殊字符的本地开发密码
DATABASE_URL=mysql+pymysql://root:your_password_here@127.0.0.1:3306/ev_charge_hub?charset=utf8mb4

# 是否在终端打印 SQLAlchemy 执行的底层 SQL（调试/写报告截图时可改为 true）
SQL_ECHO=false

# Token 签名密钥（本地开发可用随机字符串；非本地环境必须显式配置非占位且长度 >= 16 位的强随机密钥）
SECRET_KEY=replace-with-a-random-secret-key

# 是否开启开发快捷 Token 签发接口 POST /api/auth/dev-token
# 未显式设置时：本地环境（development/dev/local/test）默认 true 方便联调答辩；production 等非本地环境默认 false
ENABLE_DEV_TOKEN=true

# 登录态有效时长（单位：分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=120

# 防暴力破解策略：连续登录失败次数上限 & 账号锁定时长（单位：分钟）
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=15
